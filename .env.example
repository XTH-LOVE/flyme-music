# Supabase browser-safe values (never use the service_role key here)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-side AI values remain in .env.local only
# Defaults below match src/lib/apiGuard.ts (AI_DEFAULT_ENDPOINT / AI_DEFAULT_MODEL)
# and src-tauri/build.rs, so all three runtimes fall back to the same upstream.
AURORA_AI_API_KEY=
AURORA_AI_ENDPOINT=https://open.bigmodel.cn/api/paas/v4
AURORA_AI_MODEL=glm-4-flash
