<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Needed by any attempt at background playback. Android pauses the WebView
      when the app leaves the foreground, which stops an <audio> element, so the
      only way to keep playing is a foreground service with a MediaStyle
      notification - and those three things each require their own permission.
      WAKE_LOCK keeps the CPU alive while that service runs.

      Declared ahead of the service so the permissions are already granted when
      it lands; an unused permission costs nothing at install time on modern
      Android.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- The index bar taps give haptic feedback; without this the call is
         silently dropped. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.app"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!--
          foregroundServiceType is mandatory from Android 14: the system refuses
          to start a foreground service without a declared type, and "mediaPlayback"
          is the one that matches what this does.
        -->
        <service
            android:name=".MediaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <!-- The transport buttons in the notification arrive as
                 ACTION_MEDIA_BUTTON, and without this filter the service is not
                 a candidate to receive them. -->
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!--
          Routes notification and headset buttons into the MediaSession.

          Required, and easy to miss: MediaButtonReceiver is what
          MediaButtonReceiver.buildMediaButtonPendingIntent targets, so without
          this declaration the notification's own buttons have nowhere to go -
          they are built, drawn, and do nothing when tapped.
        -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Long-press shortcuts on the launcher icon. -->
        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <!-- Opening an audio file from a file manager. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-flac" />
            </intent-filter>
            <!-- Receiving audio shared from another app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
        <!--
          MediaPlaybackService is declared once, above, with its intent filter.
          It used to be declared twice under two names - once as .PlaybackService
          with the MEDIA_BUTTON filter, which is not a class that exists, and
          once here with the real name and no filter. So the filter applied to
          nothing and the real service had none. One declaration now carries
          both.
        -->
        <!-- Desktop lyrics. Not a foreground service: it has no ongoing work
             of its own and lives only as long as the overlay is on screen. -->
        <service
            android:name=".LyricOverlayService"
            android:exported="false" />
        <!-- Quick settings tile. BIND_QUICK_SETTINGS_TILE is required or the
             system will not offer it in the tile picker. -->
        <service
            android:name=".PlaybackTileService"
            android:exported="true"
            android:icon="@drawable/ic_note"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Home screen widget. APPWIDGET_UPDATE is the action the launcher
             sends when the widget needs its first render. -->
        <receiver
            android:name=".PlaybackWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.flyme.music.WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
</manifest>
