<?xml version="1.0" encoding="utf-8"?>
<!--
  Material Symbols, filled, on the 24dp grid the system expects.

  These replace android.R.drawable.ic_media_*, which is what most media
  notifications use. Those are the pre-Material glyphs - thin, boxy, and
  noticeably dated beside the controls Android draws itself. A vector here also
  scales cleanly, where the system ones are bitmaps drawn for a density that
  has not been current for years.

  Monochrome by design: the notification tints transport icons itself, and
  anything with its own colour ends up fighting the surface it sits on.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8,5v14l11,-7z" />
</vector>
