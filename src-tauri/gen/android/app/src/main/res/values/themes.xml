<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.app" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <!--
          `windowOptOutEdgeToEdgeEnforcement` was removed: MainActivity
          calls enableEdgeToEdge(), so the app IS edge-to-edge, and the
          theme saying otherwise is a contradiction. It is also the
          likely reason the WebView reported a zero
          env(safe-area-inset-top), which left the page header drawn
          underneath the Android status bar.
        -->
        <!-- The window background during startup. Set on the base theme so
             both light and night use the app's own colour rather than the
             platform's. -->
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
