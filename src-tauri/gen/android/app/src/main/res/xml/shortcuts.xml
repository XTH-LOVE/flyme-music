<?xml version="1.0" encoding="utf-8"?>
<!--
  Long-press shortcuts on the launcher icon.

  These are intents into the app rather than deep links, because the app is a
  single-page shell with no route table the system could address. The page reads
  the extra and navigates itself.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_note"
        android:shortcutShortLabel="@string/shortcut_search"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="com.flyme.music.SHORTCUT"
            android:targetPackage="com.flyme.music"
            android:targetClass="com.flyme.music.MainActivity">
            <extra android:name="shortcut" android:value="search" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="favourites"
        android:enabled="true"
        android:icon="@drawable/ic_note"
        android:shortcutShortLabel="@string/shortcut_favourites"
        android:shortcutLongLabel="@string/shortcut_favourites_long">
        <intent
            android:action="com.flyme.music.SHORTCUT"
            android:targetPackage="com.flyme.music"
            android:targetClass="com.flyme.music.MainActivity">
            <extra android:name="shortcut" android:value="favourites" />
        </intent>
    </shortcut>
</shortcuts>
